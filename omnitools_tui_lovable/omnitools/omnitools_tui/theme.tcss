/* ==========================================================================
   OmniTools - Cyberpunk / Dark Slate zero-gap theme
   Palette: bg #080C13 | cyan #00E5FF | emerald #00FF9D | border #1E293B
   Zero-gap: every container is 1fr / 100% with no screen padding/margin,
   and borders are drawn INSIDE the box (box-sizing: border-box is default),
   so nothing overflows the terminal edge on Windows Terminal / PowerShell.
   ========================================================================== */

Screen {
    background: #080C13;
    color: #CBD5E1;
    layout: vertical;
    padding: 0;
    margin: 0;
    overflow: hidden hidden;
    scrollbar-size: 1 1;
}

* {
    scrollbar-background: #080C13;
    scrollbar-color: #1E293B;
    scrollbar-color-hover: #00E5FF 60%;
    scrollbar-color-active: #00E5FF;
    scrollbar-corner-color: #080C13;
}

/* ---------------- Header ---------------- */
#header {
    dock: top;
    height: 3;
    width: 100%;
    background: #0B111B;
    border-bottom: solid #1E293B;
    padding: 0 1;
}
#brand {
    width: 22;
    height: 1;
    color: #00E5FF;
    text-style: bold;
    content-align: left middle;
}
#crumb {
    width: 1fr;
    height: 1;
    content-align: center middle;
    color: #E2E8F0;
}
#status-pill {
    width: 12;
    height: 1;
    content-align: center middle;
    text-style: bold;
}
#status-pill.idle    { background: #1E293B; color: #94A3B8; }
#status-pill.running { background: #00E5FF; color: #080C13; }
#status-pill.success { background: #00FF9D; color: #080C13; }
#status-pill.failed  { background: #FF3D71; color: #080C13; }

/* ---------------- Main split ---------------- */
#main {
    width: 100%;
    height: 1fr;
    padding: 0;
    margin: 0;
}
#left, #right {
    width: 1fr;          /* exact 50/50, robust against odd column counts */
    height: 100%;
    background: #080C13;
}
#left {
    border-right: solid #1E293B;
}

.section-title {
    color: #00E5FF;
    text-style: bold;
    height: 1;
    margin: 1 0 0 0;
}

/* ---------------- Category tabs ---------------- */
#categories {
    width: 100%;
    background: #0B111B;
    border-bottom: solid #1E293B;
}
#categories Tab {
    color: #64748B;
    padding: 0 1;
}
#categories Tab.-active {
    color: #00E5FF;
    text-style: bold;
}
#categories Tab:hover { color: #E2E8F0; }
#categories Underline > .underline--bar {
    color: #00E5FF;
    background: #1E293B;
}

/* ---------------- Form ---------------- */
#form {
    height: 1fr;
    padding: 0 2;
}
Select {
    width: 100%;
}
Select > SelectCurrent {
    background: #0F1623;
    border: tall #1E293B;
}
Select:focus > SelectCurrent {
    border: tall #00E5FF;
}
Select > SelectOverlay {
    background: #0F1623;
    border: tall #00E5FF;
}

#paths {
    height: 5;
    min-height: 3;
    background: #0F1623;
    border: tall #1E293B;
}
#paths:focus { border: tall #00E5FF; }

#output-dir {
    height: 3;
    width: 100%;
    background: #0F1623;
    border: tall #1E293B;
    margin-bottom: 1;
}
#output-dir:focus { border: tall #00E5FF; }

#options {
    height: auto;
    padding-bottom: 1;
}
.opt-row {
    height: 3;
    width: 100%;
}
.opt-row Label {
    height: 3;
    content-align: left middle;
    padding: 0 1;
    color: #CBD5E1;
}
.opt-label { width: 18; }
.opt-row Input, .opt-row Select {
    width: 1fr;
    background: #0F1623;
    border: tall #1E293B;
}
.opt-row Input:focus, .opt-row Select:focus { border: tall #00E5FF; }
.opt-empty { color: #475569; padding: 1 0; }

Switch {
    background: #0F1623;
    border: tall #1E293B;
}
Switch:focus { border: tall #00E5FF; }
Switch > .switch--slider { color: #1E293B; background: #0F1623; }
Switch.-on > .switch--slider { color: #00FF9D; }

/* ---------------- Run button (docked) ---------------- */
#run-btn {
    dock: bottom;
    width: 100%;
    height: 3;
    margin: 0;
    border: none;
    background: #00FF9D;
    color: #080C13;
    text-style: bold;
}
#run-btn:hover  { background: #00E5FF; }
#run-btn:focus  { background: #00E5FF; text-style: bold reverse; }

/* ---------------- Log panel ---------------- */
#log-panel {
    height: 1fr;
    padding: 0 1;
}
#log-toolbar {
    height: 3;
    width: 100%;
    align: left middle;
}
#log-title {
    width: 1fr;
    color: #00E5FF;
    text-style: bold;
}
#clear-btn {
    width: auto;
    height: 1;
    min-width: 11;
    background: #1E293B;
    color: #94A3B8;
    border: none;
    padding: 0 1;
}
#clear-btn:hover {
    background: #334155;
    color: #00E5FF;
}
#log {
    height: 1fr;
    background: #060910;
    border: round #1E293B;
    padding: 0 1;
}
#log:focus { border: round #00E5FF; }

/* ---------------- Progress Flow Card ---------------- */
#progress-card {
    dock: bottom;
    height: 5;
    width: 100%;
    background: #0B111B;
    border: round #1E293B;
    border-title-color: #00E5FF;
    padding: 0 1;
}
#progress-card.active { border: round #00E5FF; }
#progress-meta {
    height: 1;
    width: 100%;
    margin-bottom: 1;
}
#task-name { width: 1fr; color: #E2E8F0; }
#eta {
    width: 11;
    color: #00E5FF;
    text-style: bold;
    content-align: right middle;
}
#queue-badge {
    width: auto;
    margin-left: 2;
    background: #1E293B;
    color: #94A3B8;
}
#queue-badge.has-items { background: #00E5FF; color: #080C13; text-style: bold; }

#bar { width: 100%; height: 1; }
#bar Bar { width: 1fr; }                   /* stretch bar to 100% of card */
#bar Bar > .bar--bar      { color: #00E5FF; background: #1E293B; }
#bar Bar > .bar--complete { color: #00FF9D; background: #1E293B; }
#bar Bar > .bar--indeterminate { color: #00E5FF; background: #1E293B; }
#bar PercentageStatus { width: 6; color: #00FF9D; text-style: bold; }

/* ---------------- Footer ---------------- */
Footer {
    dock: bottom;
    background: #0B111B;
    color: #64748B;
}
Footer > .footer--key         { background: #1E293B; color: #00E5FF; text-style: bold; }
Footer > .footer--highlight   { background: #1E293B; }
Footer > .footer--highlight-key { background: #00E5FF; color: #080C13; }
Footer > .footer--description { color: #94A3B8; }
