Screen {
    background: #080C13;
    color: #E2E8F0;
}

#header {
    height: 3;
    padding: 0 1;
    background: #0D131D;
    border-bottom: heavy #00E5FF;
}

#app-title {
    width: 1fr;
    color: #00E5FF;
    text-style: bold;
    content-align: left middle;
}

#mode-label {
    width: 1fr;
    color: #7DD3FC;
    text-style: bold;
    content-align: center middle;
}

#status-pill {
    width: 18;
    height: 1;
    margin: 1 0;
    text-align: center;
    text-style: bold;
    color: #94A3B8;
    background: #1E293B;
}

.status-running {
    color: #080C13;
    background: #00E5FF;
    text-style: bold;
}

.status-success {
    color: #080C13;
    background: #00FF9D;
    text-style: bold;
}

.status-failed {
    color: #FFFFFF;
    background: #FF3366;
    text-style: bold;
}

#main-split {
    height: 1fr;
    padding: 1;
}

#left-panel {
    width: 3fr;
    min-width: 50;
    border: round #1E293B;
    background: #0D131D;
    padding: 0 1;
    margin-right: 1;
}

#right-panel {
    width: 2fr;
    min-width: 30;
    border: round #1E293B;
    background: #0D131D;
    padding: 0 1;
}

.panel-heading {
    height: 1;
    color: #00E5FF;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 1;
}

#category-tabs {
    height: 3;
    background: #0D131D;
    border-bottom: solid #1E293B;
}

Tabs > Tab {
    background: #111827;
    color: #94A3B8;
}

Tabs > Tab.-active {
    background: #1E293B;
    color: #00E5FF;
    text-style: bold;
    border-bottom: tall #00E5FF;
}

#form-scroll {
    height: 1fr;
    padding: 0 1;
}

.field-label {
    color: #7DD3FC;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
}

.field-row {
    height: auto;
    min-height: 3;
    align: left middle;
    padding: 0 1;
    border: round #1E293B;
    background: #111827;
    margin-top: 1;
}

.field-row Static {
    width: 1fr;
    color: #E2E8F0;
    content-align: left middle;
}

Input, Select, TextArea {
    background: #080C13;
    color: #F8FAFC;
    border: round #334155;
    margin-top: 0;
    margin-bottom: 1;
}

Input:focus, Select:focus, TextArea:focus {
    border: tall #00E5FF;
}

#input-paths {
    height: 5;
}

#output-dir {
    height: 3;
}

Switch {
    color: #00E5FF;
    padding: 0 1;
}

Button {
    background: #1E293B;
    color: #F8FAFC;
    border: none;
    text-style: bold;
}

Button:hover {
    background: #334155;
    color: #00E5FF;
}

Button:focus {
    border: tall #00E5FF;
}

Button.primary {
    background: #00E5FF;
    color: #080C13;
    text-style: bold;
}

Button.primary:hover {
    background: #38BDF8;
}

#run-tool {
    width: 1fr;
    height: 3;
    margin-top: 1;
}

#console-toolbar {
    height: 3;
    align: left middle;
}

#console-title {
    width: 1fr;
    color: #00E5FF;
    text-style: bold;
    content-align: left middle;
}

#console {
    height: 1fr;
    border: round #1E293B;
    background: #05080E;
    padding: 0 1;
    scrollbar-color: #334155;
    scrollbar-color-hover: #00E5FF;
}

#progress {
    height: 1;
    margin-top: 1;
    color: #00E5FF;
    background: #1E293B;
}

#progress-note {
    height: 2;
    color: #94A3B8;
    padding: 0 1;
}

#footer {
    height: 1;
    padding: 0 1;
    background: #0D131D;
    color: #64748B;
    border-top: solid #1E293B;
    content-align: left middle;
}
